default :
{
    name : "openmpi"
    build_source : "script"
    compil_script :  $name + ".sh"
    get_source : "archive"
    environ :
    {
       env_script : $name + ".py"
    }
    depend : [ ]
    opt_depend : [ ]
    patches : [ ]
    source_dir : $APPLICATION.workdir + $VARS.sep + 'SOURCES' + $VARS.sep + $name
    build_dir : $APPLICATION.workdir + $VARS.sep + 'BUILD' + $VARS.sep + $name
    install_dir : 'base'
    properties :
    {
        incremental : "yes"
    }
}

default_macOS:
{
    post_script : "setup-rpath-macOS.sh"
}

version_5_0_10 :
{
    build_depend : [ "pmix", "libevent" ]
    compil_script : "openmpi-5.0.10.sh"
}

default_FD44:
{
    system_info :
    {
        rpm : ["openmpi"]
        rpm_dev : ["openmpi-devel"]
    }
}
