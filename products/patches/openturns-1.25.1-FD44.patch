+find_package(Eigen3 REQUIRED NO_MODULE)
+# Modern Eigen3Config.cmake only exports the Eigen3::Eigen target and does not
+# set EIGEN3_INCLUDE_DIR; extract it from the target for legacy CMakeLists usage.
+get_target_property(EIGEN3_INCLUDE_DIR Eigen3::Eigen INTERFACE_INCLUDE_DIRECTORIES) ## MBS: added
+include_directories(${EIGEN3_INCLUDE_DIR})
+message(STATUS "libeigen found here : "  ${EIGEN3_INCLUDE_DIR})
 
 include (GNUInstallDirs)
 
