+        -e 's/[[:space:]]+-DNDEBUG[[:space:]]/ /g' \
+        -e 's/[[:space:]]+-D_GNU_SOURCE[[:space:]]/ /g' \
+        -e 's/[[:space:]]+-pedantic[[:space:]]/ /g' \
+        -e 's/[[:space:]]+-W[^[:space:]]*//g' \
+        -e 's/[[:space:]]+-O[^[:space:]]*//g' \
+        -e 's/[[:space:]]+-g[^[:space:]]*//g' \
+        -e 's/-fno-rtti[[:space:]]/-Fno-rtti /g' \
+        -e 's/[[:space:]]+-f[^[:space:]]*//g' \
+        -e 's/-Fno-rtti[[:space:]]/-fno-rtti /g' \
