+    expr "x$ac_option" : ".*[^-._$as_cr_alnum]" >/dev/null &&
+      printf '%s\n' "$as_me: WARNING: invalid host type: $ac_option" >&2
+    : "${build_alias=$ac_option} ${host_alias=$ac_option} ${target_alias=$ac_option}"
+    ;;
