+  --enable-nine           enable build of the nine Direct3D9 API [default=no]
+  --enable-xvmc           enable xvmc library [default=auto]
+  --enable-vdpau          enable vdpau library [default=auto]
+  --enable-omx            DEPRECATED: Use --enable-omx-bellagio or
