+  if test -s confdefs.h; then
+    printf '%s\n' "## ----------- ##
+## confdefs.h. ##
+## ----------- ##"
+    echo
+    cat confdefs.h
+    echo
+  fi
+  test "$ac_signal" != 0 &&
+    printf '%s\n' "$as_me: caught signal $ac_signal"
+  printf '%s\n' "$as_me: exit $exit_status"
+}
