+detect_old_buggy_llvm() {
+                        LLVM_SO_NAME=LLVM-`$LLVM_CONFIG --version`
+    if test -f "$LLVM_LIBDIR/lib$LLVM_SO_NAME.$IMP_LIB_EXT"
+then :
+  llvm_have_one_so=yes
+fi
