diff -ruN planegcs/CMakeLists.txt planegcs-dev/CMakeLists.txt
--- planegcs/CMakeLists.txt	2018-09-04 14:51:03.000000000 +0100
+++ planegcs-dev/CMakeLists.txt	2026-07-08 11:40:31.673530882 +0100
@@ -19,7 +19,7 @@
     add_definitions(-DFCAppSketcher -DHAVE_ACOSH -DHAVE_ASINH -DHAVE_ATANH -DPLANEGCS_EXPORTS)
 else(MSVC)
     add_definitions(-DHAVE_LIMITS_H -DHAVE_CONFIG_H)
-    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -std=c++11")
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -std=c++14") #MBS: changed from C++11 to C++14 (required by Eigen3)
 endif(MSVC)
 
 add_definitions(-D_GCS_USE_STL_OUTPUT -D_GCS_DO_NOT_FREE_CONSTRAINTS_MEMORY)
@@ -56,13 +56,22 @@
 
 FILE(TO_CMAKE_PATH "$ENV{EIGEN_ROOT_DIR}" EIGEN_ROOT_DIR)
 set(EIGEN3_INCLUDE_DIR "${EIGEN_ROOT_DIR}/include/eigen3")
-MESSAGE("EIGEN3_INCLUDE_DIR: " ${EIGEN3_INCLUDE_DIR})
-find_package(Eigen3 3.2.7 REQUIRED)
-if(NOT EIGEN3_FOUND)
-  message("====================\n"
-          "Eigen3 was not found\n"
-          "====================\n")
-endif(NOT EIGEN3_FOUND)
+message("EIGEN3_INCLUDE_DIR: " ${EIGEN3_INCLUDE_DIR})
+find_package(Eigen3 REQUIRED) ## MBS: (Eigen3 3.2.7 REQUIRED)
+# MBS: Modern Eigen3Config.cmake only exports the Eigen3::Eigen target and does not
+# set EIGEN3_INCLUDE_DIR; extract it from the target for legacy CMakeLists usage.
+IF(NOT EIGEN3_INCLUDE_DIR AND TARGET Eigen3::Eigen)
+  GET_TARGET_PROPERTY(EIGEN3_INCLUDE_DIR Eigen3::Eigen INTERFACE_INCLUDE_DIRECTORIES)
+  # Check if include dirs is not empty
+  IF(NOT EIGEN3_INCLUDE_DIR)
+    message("====================\n"
+            "Eigen3 was not found\n"
+            "====================\n")
+  ELSE()
+    SET(EIGEN3_FOUND TRUE)
+    message(STATUS "MBS: Eigen3 found : ${EIGEN3_FOUND}  at  ${EIGEN3_INCLUDE_DIR}")
+  ENDIF()
+ENDIF()
 
