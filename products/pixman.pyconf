default :
{
    name : "pixman"
    build_source : "script"
    compil_script :  $name + $VARS.scriptExtension
    get_source : "archive"
    system_info : 
    {
        rpm : ["pixman"]
        rpm_dev : ["pixman-devel"]
        apt : ["libpixman-1-0"]
        apt_dev : ["libpixman-1-dev"]
    }
    environ :
    {
       env_script : $name + ".py"
    }
    depend : [ ]
    patches : [ ]
    source_dir : $APPLICATION.workdir + $VARS.sep + 'SOURCES' + $VARS.sep + $name
    build_dir : $APPLICATION.workdir + $VARS.sep + 'BUILD' + $VARS.sep + $name
    install_dir : 'base'
    properties :
    {
        incremental : "yes"
        single_install_dir : "yes"
    }
}

default_macOS:
{
    post_script : "setup-rpath-macOS.sh"
}

